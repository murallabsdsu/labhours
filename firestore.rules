rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function approvedUser() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true;
    }
    function okFields(d) {
      return d.keys().hasOnly(['uid','date','start','end','hours','loc','place','task','output','status','createdAt','updatedAt','note','approvedHours','approvedAt','addedBy','extra'])
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.start is string && d.start.matches('^[0-2][0-9]:[0-5][0-9]$')
        && d.end is string && d.end.matches('^[0-2][0-9]:[0-5][0-9]$')
        && d.end > d.start
        && d.loc is string && d.loc.size() > 0 && d.loc.size() <= 40
        && d.place is string && d.place.size() <= 80
        && d.task is string && d.task.size() >= 2 && d.task.size() <= 600
        && (!('extra' in d) || (d.extra is map && d.extra.size() <= 12));
    }

    match /admins/{id} {
      allow read: if signedIn() && request.auth.uid == id;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.approved == false
        && request.resource.data.keys().hasOnly(['email','requestedName','approved','createdAt'])
        && request.resource.data.requestedName is string && request.resource.data.requestedName.size() <= 40;
      allow update, delete: if isAdmin();
    }

    match /entries/{id} {
      allow read: if signedIn() && (isAdmin() || resource.data.uid == request.auth.uid);
      allow create: if isAdmin() || (approvedUser()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && okFields(request.resource.data)
        && !('note' in request.resource.data) && !('approvedHours' in request.resource.data) && !('addedBy' in request.resource.data));
      allow update: if isAdmin() || (approvedUser()
        && resource.data.uid == request.auth.uid
        && resource.data.status in ['pending', 'returned']
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.get('note', null) == resource.data.get('note', null)
        && request.resource.data.get('approvedHours', null) == resource.data.get('approvedHours', null)
        && request.resource.data.get('addedBy', null) == resource.data.get('addedBy', null)
        && okFields(request.resource.data));
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid
        && resource.data.status in ['pending', 'returned']);
    }

    match /adminNotes/{id} {
      allow read, write: if isAdmin();
    }

    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
